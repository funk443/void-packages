do_install() {
	vmkdir usr/share/fonts/roboto
	vcopy hinted/*.ttf usr/share/fonts/roboto
	vcopy RobotoMono*/fonts/variable/*.ttf usr/share/fonts/roboto
	vcopy variable/RobotoSerif*.ttf usr/share/fonts/roboto
}
